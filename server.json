{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "it.natlex/stellara-mcp",
  "description": "Swiss Ephemeris for AI agents: exact natal charts, transits, synastry and birth-place resolution",
  "status": "active",
  "repository": {
    "url": "https://github.com/mihnin/stellara-mcp",
    "source": "github"
  },
  "version": "0.2.2",
  "websiteUrl": "https://stellara.natlex.it/#api",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.stellara.natlex.it/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "stellara-mcp",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "STELLARA_API_KEY",
          "description": "Stellara API access key (request at https://stellara.natlex.it/#api)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "STELLARA_API_BASE_URL",
          "description": "Override the API base URL (default https://api.stellara.natlex.it/api/v1/astrology)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
